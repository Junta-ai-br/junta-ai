# Optional: Google login Client ID. Leave empty to keep Google unavailable.
VITE_GOOGLE_CLIENT_ID=
# Required for email OTP and real Google authentication: backend base URL.
# Also required for public Contact/Feedback forms: use the real public HTTPS
# backend base URL on Azure, without /contact or /feedback.
# Without this URL, the existing Google profile login remains available when Client ID is set.
VITE_API_URL=
